{
    "manifest_version": 2,
    "id": "zbx-user-migrate",
    "name": "User Migration",
    "version": "1.2.0",
    "author": "Rafael M. A. Leão Ereno - MALE",
    "url": "https://www.linkedin.com/in/leaoereno/",
    "description": "Transfers all owned objects (dashboards, maps, reports, media, actions, groups) between Zabbix users, detecting the real authentication method (Local, LDAP or SAML) of both source and destination.",
    "namespace": "UserMigrate",
    "actions": {
        "usermigrate.view": {
            "class": "CControllerUserMigrateView",
            "view": "usermigrate.view",
            "layout": "layout.htmlpage"
        },
        "usermigrate.preview": {
            "class": "CControllerUserMigratePreview",
            "layout": "layout.json"
        },
        "usermigrate.execute": {
            "class": "CControllerUserMigrateExecute",
            "layout": "layout.json"
        },
        "usermigrate.report": {
            "class": "CControllerUserMigrateReport",
            "view": "usermigrate.report",
            "layout": "layout.htmlpage"
        }
    }
}